// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  role     UserRole  @default(USER)
  name     String
  email    String    @unique
  password String
  createAt DateTime  @default(now())
  updateAt DateTime  @updatedAt
  cart     Product[] @relation("cart")
  favList  Product[] @relation("favList")
}

model Product {
  id         String     @id @default(uuid())
  title      String
  content    String
  price      Float
  rating     Float
  createAt   DateTime   @default(now())
  UpdateAt   DateTime   @updatedAt
  user       User?      @relation("cart", fields: [userId], references: [id])
  userId     String?
  favBy      User?      @relation("favList", fields: [favByID], references: [id])
  favByID    String?
  categories Category[]
}

model Category {
  id       String    @id @default(uuid())
  products Product[]
}

enum UserRole {
  USER
  ADMIN
}
